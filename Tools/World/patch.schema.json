{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aaris core patch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reason", "expected_files", "operations"],
  "properties": {
    "schema_version": {"const": 1},
    "reason": {"type": "string", "minLength": 1},
    "expected_files": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "operations": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["op", "target"], "properties": {
        "op": {"const": "set_transform"}, "target": {"type": "string", "pattern": "^scene:[a-f0-9]{32}:-?[0-9]+$"},
        "local_position": {"$ref": "#/$defs/vec3"},
        "local_rotation_xyzw": {"$ref": "#/$defs/vec4"},
        "local_scale": {"$ref": "#/$defs/vec3"}
      }, "anyOf": [{"required": ["local_position"]}, {"required": ["local_rotation_xyzw"]}, {"required": ["local_scale"]}]},
      {"type": "object", "additionalProperties": false, "required": ["op", "path", "file_id", "property", "rgba"], "properties": {
        "op": {"const": "set_material_color"}, "path": {"type": "string", "pattern": "^Assets/.*\\.mat$"},
        "file_id": {"type": "integer"}, "property": {"type": "string", "minLength": 1}, "rgba": {"$ref": "#/$defs/vec4"}
      }},
      {"type": "object", "additionalProperties": false, "required": ["op", "center_xz", "radius_m", "delta_m"], "properties": {
        "op": {"const": "terrain_brush"}, "center_xz": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "radius_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 100}, "delta_m": {"type": "number", "minimum": -20, "maximum": 20}
      }}
    ]}}
  },
  "$defs": {
    "vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "vec4": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}
  }
}
