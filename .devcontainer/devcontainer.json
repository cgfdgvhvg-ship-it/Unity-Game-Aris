{
  "name": "Aaris Unity AI Codespace",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/Unity-Game-Aris",
  "containerEnv": {
    "DISPLAY": ":99"
  },
  "postCreateCommand": "bash .devcontainer/finalize.sh",
  "postStartCommand": "bash .devcontainer/start_screen.sh",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "onCreateCommand": "bash .devcontainer/prebuild.sh"
}
