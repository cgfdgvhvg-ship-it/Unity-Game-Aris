{
  "name": "Aaris Unity — full Editor preinstalled in lean image (optional)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "remoteUser": "codespace",
  "forwardPorts": [
    6080
  ],
  "portsAttributes": {
    "6080": {
      "label": "Aaris private noVNC desktop",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  },
  "features": {}
}
